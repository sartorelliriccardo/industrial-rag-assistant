# Copy to .env (which is git-ignored) and fill in. Never commit real keys.
# The app and the offline engine work without any key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Optional: ask for a password before showing the app (also works as a Streamlit secret).
APP_PASSWORD=
# Minutes without interaction after which uploaded documents are deleted (0 = never).
DOC_IDLE_MINUTES=15
